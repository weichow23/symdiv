{
  "provider": "codex_exec",
  "model": "gpt-5.6-sol",
  "reasoning_effort": "medium",
  "codex_command": "codex",
  "output_schema": "schemas/path-guidance-v3.schema.json",
  "prompt": "prompts/path_guidance_v3.txt",
  "timeout_seconds": 90,
  "max_calls": 80,
  "max_total_tokens": 1800000,
  "max_retries": 0,
  "loop_bound": 8,
  "state_budget": 128,
  "query_budget": 256,
  "z3_timeout_ms": 1000,
  "search_wall_seconds": 30,
  "guidance_states": 80,
  "repair_min_states": 16,
  "repair_states": 32,
  "selective_warm_states": 64,
  "local_first_seconds": 2,
  "minimum_model_seconds": 12,
  "wall_budget_seconds": 30,
  "timing_repetitions": 3,
  "random_seeds": [11, 29, 47],
  "portfolio_policies": ["distance", "coverage", "dfs", "discrepancy"],
  "portfolio_batch": 16,
  "lookahead_states": 64,
  "lookahead_queries": 16,
  "lookahead_seconds": 1
